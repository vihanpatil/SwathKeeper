{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(colcon build:*)",
      "Bash(colcon test:*)",
      "Bash(colcon list:*)",
      "Bash(ros2 topic:*)",
      "Bash(ros2 node:*)",
      "Bash(ros2 launch:*)",
      "Bash(ros2 run:*)",
      "Bash(ros2 param:*)",
      "Bash(ros2 bag:*)",
      "Bash(ros2 pkg:*)",
      "Bash(colcon:*)",
      "Bash(source install/setup.bash:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(python3:*)",
      "Bash(pip install:*)",
      "Bash(pip list:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(docker build:*)",
      "Bash(docker compose build:*)",
      "Bash(docker compose up:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(docker compose down:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Read(./**/*.env)",
      "Read(./**/secrets/**)"
    ]
  },
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2"
  }
}
